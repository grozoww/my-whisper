{
  "swift.disableAutoResolve": true,

  // build/ is visible on purpose: it holds OurWhisper.app, the symlink you launch and attach the
  // debugger to. It is excluded from search only, so grepping the project does not return hits
  // inside a 26 MB build product.
  "search.exclude": {
    "build": true
  },
  "files.exclude": {
    "**/.DS_Store": true
  },
  "files.watcherExclude": {
    "**/build/**": true
  }
}
